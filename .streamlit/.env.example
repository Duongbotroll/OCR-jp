# =============================================================================
# Japanese Handwritten OCR - Environment configuration
# Copy file này thành .env rồi điền giá trị:   cp .env.example .env
# KHÔNG commit file .env lên Git (đã được chặn trong .gitignore).
# =============================================================================

# --- General -----------------------------------------------------------------
LOG_LEVEL=INFO
OUTPUT_DIR=./outputs
PDF_DPI=200
MAX_PDF_PAGES=20

# -----------------------------------------------------------------------------
# PRESET "KHÔNG CẦN GPU" (Streamlit Cloud / máy yếu): dùng Gemini qua API
# Lấy key miễn phí tại https://aistudio.google.com/apikey, rồi đặt:
#   OCR_BACKEND=openai-compatible
#   OCR_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OCR_API_KEY=<GEMINI_API_KEY>
#   OCR_API_MODEL=gemini-2.5-flash          (kiểm tra tên model mới nhất trong docs)
#   OCR_MAX_NEW_TOKENS=8192                 (Gemini "thinking" dùng chung ngân sách token)
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<GEMINI_API_KEY>
#   LLM_MODEL=gemini-2.5-flash
#   LLM_MAX_TOKENS=8192
# -----------------------------------------------------------------------------

# --- Stage 1: Pre-processing & Layout ----------------------------------------
PREPROCESS_MAX_SIDE=2048
PREPROCESS_DENOISE=true
PREPROCESS_DENOISE_STRENGTH=10
PREPROCESS_CLAHE=true
PREPROCESS_DESKEW=true
PREPROCESS_MAX_SKEW_ANGLE=10
PREPROCESS_CROP_BORDERS=true
PREPROCESS_BINARIZE_FOR_OCR=false
PREPROCESS_LAYOUT_ANALYSIS=true
PREPROCESS_MIN_BLOCK_AREA=400
# auto | horizontal | vertical
PREPROCESS_TEXT_DIRECTION=auto

# --- Stage 2: Vision-Language OCR Engine -------------------------------------
# qwen2.5-vl | glm-ocr | got-ocr2 | openai-compatible
OCR_BACKEND=qwen2.5-vl
# Để trống để dùng model mặc định của backend. Ví dụ bản nhẹ cho GPU 8-12GB:
# OCR_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
OCR_MODEL_ID=
# auto | cuda | cuda:0 | mps | cpu
OCR_DEVICE=auto
# auto | float32 | float16 | bfloat16
OCR_DTYPE=auto
# page (khuyến nghị) | block
OCR_MODE=page
OCR_MAX_NEW_TOKENS=2048
OCR_REPETITION_PENALTY=1.05
OCR_TRUST_REMOTE_CODE=false
OCR_QWEN_MAX_PIXELS=1003520
HF_CACHE_DIR=
# Token Hugging Face (chỉ cần với model gated/private)
HF_TOKEN=

# Dùng khi OCR_BACKEND=openai-compatible (vd: vllm serve Qwen/Qwen2.5-VL-7B-Instruct)
OCR_API_BASE_URL=http://localhost:8000/v1
OCR_API_KEY=
OCR_API_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OCR_API_TIMEOUT=120

# --- Stage 3: LLM Post-Correction --------------------------------------------
# LLM_API_KEY (nếu đặt) được ưu tiên hơn OPENAI_API_KEY / ANTHROPIC_API_KEY
LLM_API_KEY=
# openai | anthropic | none
LLM_PROVIDER=openai
# Để trống để dùng model mặc định của provider
LLM_MODEL=
OPENAI_API_KEY=
# Server OpenAI-compatible (Ollama: http://localhost:11434/v1, vLLM: http://localhost:8001/v1)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
# Hallucination guard: từ chối bản sửa nếu thay đổi > 25% ký tự
LLM_MAX_EDIT_RATIO=0.25
LLM_MAX_CHARS_PER_CHUNK=1500
