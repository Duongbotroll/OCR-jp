# =============================================================================
# Mẫu Streamlit Secrets - dùng khi deploy lên Streamlit Community Cloud
# (App settings -> Secrets -> dán nội dung dưới đây, thay key thật của bạn).
#
# Chạy local: có thể copy thành .streamlit/secrets.toml (đã được .gitignore chặn),
# hoặc dùng file .env như bình thường.
# Mọi key ở cấp gốc được app.py tự đưa vào biến môi trường cho config.py đọc.
# =============================================================================

# --- Tầng 2: OCR qua Gemini (không cần GPU) ---
OCR_BACKEND = "openai-compatible"
OCR_API_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
OCR_API_KEY = "YOUR_GEMINI_API_KEY"
OCR_API_MODEL = "gemini-2.5-flash"
OCR_MAX_NEW_TOKENS = 8192

# --- Tầng 3: LLM post-correction (dùng lại Gemini qua giao thức OpenAI) ---
LLM_PROVIDER = "openai"
OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY = "YOUR_GEMINI_API_KEY"
LLM_MODEL = "gemini-2.5-flash"
LLM_MAX_TOKENS = 8192

# --- Giới hạn tài nguyên cho môi trường cloud miễn phí ---
PREPROCESS_MAX_SIDE = 2048
MAX_PDF_PAGES = 5
